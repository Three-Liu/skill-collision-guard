{
  "name": "skill-collision-guard",
  "version": "0.1.1",
  "description": "Detect conflicting coding-agent skills before install or invocation.",
  "license": "MIT",
  "bin": {
    "skill-guard": "./bin/skill-guard.js"
  },
  "main": "./src/index.js",
  "files": [
    ".codex-plugin/",
    ".claude-plugin/",
    ".github/plugin/",
    ".opencode/",
    ".cursor/",
    ".windsurf/",
    ".clinerules/",
    ".qoder/",
    ".qoder-plugin/",
    "bin/",
    "docs/",
    "hooks/",
    "assets/",
    "scripts/",
    "skills/",
    "src/",
    "AGENTS.md",
    "GEMINI.md",
    "opencode.json",
    "plugin.json",
    "plugin.yaml",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "sync:skill-bundle": "node scripts/sync-skill-bundle.js",
    "check:skill-bundle": "node scripts/sync-skill-bundle.js --check",
    "check": "node --check bin/skill-guard.js && node --check hooks/skill-guard-hook.js && npm run check:skill-bundle && node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent-skills",
    "codex",
    "claude-code",
    "coding-agent",
    "plugin",
    "skill"
  ]
}

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-guard-hook.js\" --agent codex",
            "timeout": 5,
            "statusMessage": "Loading skill collision state...",
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-guard-hook.js\" --agent codex",
            "timeout": 8,
            "statusMessage": "Checking skill collisions...",
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-guard-hook.js\" --agent codex",
            "timeout": 25,
            "statusMessage": "Checking skill installation...",
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-guard-hook.js\" --agent codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
